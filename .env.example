NPM_SOURCE_URL=http://127.0.0.1:81
NPM_SOURCE_USER=admin@example.com
NPM_SOURCE_PASSWORD=change-me

NPM_DESTINATION_URL=http://127.0.0.2:81
NPM_DESTINATION_USER=admin@example.com
NPM_DESTINATION_PASSWORD=change-me

NPM_MIGRATION_MODE=skip

NPM_BACKUP_DIR=backups

NPM_SERVER_URL=http://127.0.0.2:81
NPM_USER=admin@example.com
NPM_PASSWORD=change-me

NPM_SSL_CERTIFICATE_ID=3
NPM_TARGET_DOMAIN=example.com
NPM_ENABLE_HTTP2=true
NPM_SSL_FORCED=true
NPM_LOG_FILE=logs/npm-migration.jsonl
NPM_REPORT_DIR=reports
